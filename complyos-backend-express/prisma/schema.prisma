// ComplianceOS — Prisma Schema (PostgreSQL via Supabase)
// Stack: PERN — PostgreSQL + Express + React + Node.js

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  owner
  ca
  admin
}

enum SubscriptionPlan {
  free
  growth
  pro
  ca_lite
  ca_pro
}

enum ComplianceStatus {
  pending
  completed
  overdue
  flagged
}

enum Urgency {
  high
  medium
  low
}

enum AlertStatus {
  unread
  read
  dismissed
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  phone           String?
  passwordHash    String   @map("password_hash")
  fullName        String   @map("full_name")
  role            UserRole @default(owner)
  plan            SubscriptionPlan @default(free)
  language        String   @default("hi")  // ISO 639-1
  consentGiven    Boolean  @default(false) @map("consent_given")
  consentAt       DateTime? @map("consent_at")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  businessProfile BusinessProfile?
  documents       Document[]
  deadlines       ComplianceDeadline[]
  notifications   Notification[]
  caClients       CAClientMap[]        @relation("CAClients")
  caRelation      CAClientMap?         @relation("ClientCA")
  sentinelAlerts  SentinelAlert[]
  subscription    Subscription?

  @@map("users")
}

// ─── Business Profile ─────────────────────────────────────────────────────────

model BusinessProfile {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  businessName    String?  @map("business_name")
  gstin           String?  @unique
  pan             String?
  udyamNumber     String?  @map("udyam_number")
  fssaiNumber     String?  @map("fssai_number")
  cinNumber       String?  @map("cin_number")
  businessType    String?  @map("business_type")  // trader/manufacturer/service
  sector          String?
  state           String?
  district        String?
  annualTurnover  Float?   @map("annual_turnover")  // in lakhs INR
  employeeCount   Int?     @map("employee_count")
  isWomenLed      Boolean  @default(false) @map("is_women_led")
  registeredDate  DateTime? @map("registered_date")
  healthScore     Int?     @map("health_score")  // 0-100 deterministic
  penaltyAtRisk   Float?   @map("penalty_at_risk")  // INR, deterministic
  schemeHeadroom  Int?     @map("scheme_headroom")  // count of eligible schemes
  ariaSessionId   String?  @map("aria_session_id")  // active ARIA slot-fill session
  profileComplete Boolean  @default(false) @map("profile_complete")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schemeMatches   SchemeMatch[]

  @@map("business_profiles")
}

// ─── Documents ────────────────────────────────────────────────────────────────

model Document {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  filename        String
  cloudinaryUrl   String?  @map("cloudinary_url")
  cloudinaryId    String?  @map("cloudinary_id")
  documentType    String?  @map("document_type")  // GST Certificate/Notice/Invoice etc
  ocrText         String?  @map("ocr_text")        // raw extracted text
  extractedData   Json?    @map("extracted_data")  // VEDA structured output
  confidenceScore Float?   @map("confidence_score") // 0.0 - 1.0
  needsReview     Boolean  @default(false) @map("needs_review")  // below confidence gate
  processedByVeda Boolean  @default(false) @map("processed_by_veda")
  caApproved      Boolean? @map("ca_approved")
  caNote          String?  @map("ca_note")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deadlines       ComplianceDeadline[]

  @@map("documents")
}

// ─── Compliance Deadlines ─────────────────────────────────────────────────────

model ComplianceDeadline {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  title           String
  description     String?
  deadlineDate    DateTime @map("deadline_date")
  complianceType  String   @map("compliance_type")  // gst_return/tds/udyam/fssai/epfo
  status          ComplianceStatus @default(pending)
  urgency         Urgency  @default(medium)
  sourceUrl       String?  @map("source_url")    // official govt link
  lastVerifiedAt  DateTime? @map("last_verified_at")
  sourceDocumentId String? @map("source_document_id")  // Document.id if from VEDA
  createdByAgent  String?  @map("created_by_agent")  // ARIA/VEDA/SENTINEL
  penaltyEstimate Float?   @map("penalty_estimate")  // INR, deterministic calc
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document        Document? @relation(fields: [sourceDocumentId], references: [id])

  @@map("compliance_deadlines")
}

// ─── Schemes ──────────────────────────────────────────────────────────────────

model Scheme {
  id              String   @id @default(uuid())
  name            String
  nameHindi       String?  @map("name_hindi")
  description     String
  descriptionHindi String? @map("description_hindi")
  ministry        String?
  schemeType      String   @map("scheme_type")  // loan/subsidy/registration/insurance
  maxBenefit      String?  @map("max_benefit")  // e.g. "₹5 lakh"
  eligibilityCriteria Json @map("eligibility_criteria")  // structured rules
  officialUrl     String   @map("official_url")
  checklist       Json?    // required documents
  sourceUrl       String   @map("source_url")
  retrievedOn     DateTime @map("retrieved_on")
  checkedBy       String?  @map("checked_by")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  matches         SchemeMatch[]

  @@map("schemes")
}

model SchemeMatch {
  id              String   @id @default(uuid())
  businessId      String   @map("business_id")
  schemeId        String   @map("scheme_id")
  matchScore      Float    @map("match_score")   // 0.0 - 1.0
  criteriaMetCount Int     @map("criteria_met_count")
  criteriaTotalCount Int   @map("criteria_total_count")
  missingInfo     Json?    @map("missing_info")  // fields needed for full match
  explanationHindi String? @map("explanation_hindi")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  business        BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  scheme          Scheme   @relation(fields: [schemeId], references: [id])

  @@unique([businessId, schemeId])
  @@map("scheme_matches")
}

// ─── Sentinel Alerts ──────────────────────────────────────────────────────────

model SentinelAlert {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  title           String
  titleHindi      String?  @map("title_hindi")
  summary         String
  summaryHindi    String?  @map("summary_hindi")
  sourceUrl       String   @map("source_url")
  lastVerifiedAt  DateTime @map("last_verified_at")
  isSimulated     Boolean  @default(false) @map("is_simulated")  // demo label
  affectedAttributes Json? @map("affected_attributes")  // state/sector/turnover
  status          AlertStatus @default(unread)
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sentinel_alerts")
}

// ─── Regulation Tracking ─────────────────────────────────────────────────────

model RegulationSource {
  id          String   @id @default(uuid())
  url         String
  type        String
  stateScope  String
  fetchVia    String
  checkEvery  String
  simulated   Boolean  @default(false)
  enabled     Boolean  @default(true)
  owner       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  snapshots   RegulationSnapshot[]
  changes     RegulationChange[]
  tinyFishCalls TinyFishCall[]

  @@map("regulation_sources")
}

model RegulationSnapshot {
  id          String   @id @default(uuid())
  sourceId    String   @map("source_id")
  hash        String
  text        String
  fetchedAt   DateTime @default(now()) @map("fetched_at")

  source      RegulationSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  changes     RegulationChange[]

  @@index([sourceId, fetchedAt])
  @@map("regulation_snapshots")
}

model RegulationChange {
  id               String   @id @default(uuid())
  sourceId         String   @map("source_id")
  snapshotId       String   @map("snapshot_id")
  changedParagraphs Json    @map("changed_paragraphs")
  status           String   // PENDING_CLASSIFY|NEEDS_REVIEW|APPROVED|REJECTED|ALERTED
  classification    Json?
  quoteVerified    Boolean  @default(false) @map("quote_verified")
  simulated        Boolean  @default(false)
  createdAt        DateTime @default(now()) @map("created_at")
  reviewedBy       String?  @map("reviewed_by")

  source            RegulationSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  snapshot          RegulationSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  regulationAlerts  RegulationAlert[]

  @@map("regulation_changes")
}

model RegulationAlert {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  changeId    String   @map("change_id")
  status      String
  sentAt      DateTime? @map("sent_at")
  error       String?
  isDigest    Boolean  @default(false) @map("is_digest")
  createdAt   DateTime @default(now()) @map("created_at")

  change      RegulationChange @relation(fields: [changeId], references: [id], onDelete: Cascade)

  @@unique([userId, changeId])
  @@map("regulation_alerts")
}

model TinyFishCall {
  id          String   @id @default(uuid())
  endpoint    String
  costClass   String   @map("cost_class")
  status      String
  durationMs  Int      @map("duration_ms")
  sourceId    String?  @map("source_id")
  createdAt   DateTime @default(now()) @map("created_at")

  source      RegulationSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@map("tiny_fish_calls")
}

// ─── CA Client Map ────────────────────────────────────────────────────────────

model CAClientMap {
  id        String   @id @default(uuid())
  caId      String   @map("ca_id")
  clientId  String   @unique @map("client_id")
  addedAt   DateTime @default(now()) @map("added_at")

  // Relations
  ca        User     @relation("CAClients", fields: [caId], references: [id])
  client    User     @relation("ClientCA", fields: [clientId], references: [id])

  @@unique([caId, clientId])
  @@map("ca_client_map")
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  title       String
  body        String
  channel     String   @default("in_app")  // in_app/whatsapp/sms/email
  isRead      Boolean  @default(false) @map("is_read")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ─── Subscription ─────────────────────────────────────────────────────────────

model Subscription {
  id                 String   @id @default(uuid())
  userId             String   @unique @map("user_id")
  plan               SubscriptionPlan
  razorpaySubId      String?  @map("razorpay_sub_id")
  razorpayCustomerId String?  @map("razorpay_customer_id")
  status             String   @default("active")  // active/cancelled/paused
  currentPeriodEnd   DateTime? @map("current_period_end")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ─── ARIA Chat Sessions ───────────────────────────────────────────────────────

model ARIASession {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  sessionId   String   @unique @map("session_id")
  messages    Json     @default("[]")  // [{role, content}]
  slotsFilled Json     @default("{}") @map("slots_filled")  // profile fields captured
  isComplete  Boolean  @default(false) @map("is_complete")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("aria_sessions")
}
