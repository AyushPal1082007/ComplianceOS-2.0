# ComplianceOS — Express Backend Environment Variables
# Copy to .env and fill in real values

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# ─── Database (Supabase PostgreSQL) ───────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/complyos_db"

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=dev-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# ─── Groq API (LLM) ───────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama3-70b-8192

# ─── Bhashini ASR (Hindi Speech-to-Text) — FREE govt funded ──────────────────
BHASHINI_USER_ID=your-bhashini-user-id
BHASHINI_API_KEY=your-bhashini-api-key
BHASHINI_PIPELINE_ID=your-pipeline-id

# ─── Google Cloud Vision API ──────────────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json
GCP_PROJECT_ID=your-gcp-project-id

# ─── Cloudinary (File Storage) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret

# ─── Upstash Redis (BullMQ Queue) ─────────────────────────────────────────────
UPSTASH_REDIS_URL=rediss://your-upstash-url
UPSTASH_REDIS_TOKEN=your-upstash-token

# ─── Razorpay (Test Mode) ─────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# ─── WhatsApp Cloud API ───────────────────────────────────────────────────────
WHATSAPP_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# ─── Resend (Email Alerts) ────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=alerts@complyos.in

# ─── Fast2SMS (SMS Fallback) ──────────────────────────────────────────────────
FAST2SMS_API_KEY=your-fast2sms-key
